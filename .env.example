
# Django (local defaults are fine; production values go in Render)
# DEBUG=1
# SECRET_KEY=
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Production database (Neon): when set, it replaces the DB_* values below
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# PostgreSQL Database Configuration (local docker-compose)

DB_NAME=fieldshift_db
DB_USER=fieldshift_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# AI explanations (optional: without a key the app uses template text)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Free AI option: a Google AI Studio key (https://aistudio.google.com/apikey).
# Used when LLM_API_KEY is empty. GEMINI_MODEL is optional (default: gemini-flash-latest).
GEMINI_API_KEY=
# GEMINI_MODEL=
# LLM_PROVIDER=gemini
